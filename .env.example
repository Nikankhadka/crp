# Copy to .env and fill in. Never commit the real .env.

# LLM provider (OpenAI-compatible). Defaults to the free OpenCode Zen gateway.
# OPENCODE_API_KEY is accepted as an alias for LLM_API_KEY.
LLM_API_KEY=replace-me
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=nemotron-3.5-lightning-free
# Optional request timeout in milliseconds (default 90000). On Vercel a lower value (e.g. 45000)
# is advisable so a slow call plus the fallback still fits inside the 300 second function limit.
LLM_TIMEOUT_MS=90000

# Optional free fallback, used once when the primary returns 429, 5xx or times out.
# Set LLM_FALLBACK_MODEL or LLM_FALLBACK_BASE_URL to activate it. The fallback key
# reuses LLM_API_KEY unless LLM_FALLBACK_API_KEY is set.
LLM_FALLBACK_BASE_URL=https://opencode.ai/zen/v1
LLM_FALLBACK_MODEL=nemotron-3-ultra-free

# Database. Leave DATABASE_URL unset for local dev: an embedded Postgres (PGlite) is used and
# persisted under STORAGE_DIR/pgdata (default ./storage/pgdata). Set it for Vercel + Supabase:
# use the Supabase transaction pooler URL (port 6543; the app opens at most 3 connections) with
# `?sslmode=no-verify`. pg-connection-string 2.14 treats `sslmode=require` as `verify-full`,
# which fails against Supabase's certificate chain. Without any sslmode the connection is plaintext.
# DATABASE_URL=postgres://user:password@host:6543/postgres?sslmode=no-verify
# Apply the schema by hand with `npm run db:migrate`; the server also migrates on start.
# Do not run `npm run db:migrate` while `next dev` is running: PGlite is single-process and
# storage/pgdata is held open by the dev server.

# The single owner user every request acts as until real sign-in lands.
# OWNER_EMAIL=owner@local
# First-run import into an empty owner account: a dir with profile.yaml, resume.yaml and
# personal.md, and a dir holding the reference markdown files. Never overwrites existing data.
# BOOTSTRAP_SEED_DIR=seed/me
# BOOTSTRAP_DOCS_DIR=.
# Seconds a running job may go without an update before it is marked "timed out" (default 420)
# JOB_STALE_SECONDS=420

# Optional absolute path to a typst binary (default: bin/typst-linux-x64 on linux, else PATH)
# TYPST_BIN=/usr/local/bin/typst

# Job sources (later slices)
FIRECRAWL_API_KEY=replace-me
ADZUNA_APP_ID=replace-me
ADZUNA_APP_KEY=replace-me

# App session and notifications (later slices)
SESSION_SECRET=replace-me
ALLOW_SIGNUP=false
NTFY_TOPIC=replace-me
