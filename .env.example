# Copy to .env and fill in. Never commit the real .env.

# LLM provider (OpenAI-compatible)
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-model
# Optional request timeout in milliseconds (default 90000)
LLM_TIMEOUT_MS=90000

# LLM fallback provider, used once when the primary returns 429, 5xx or times out
LLM_FALLBACK_BASE_URL=https://your-fallback.example/v1
LLM_FALLBACK_API_KEY=replace-me
LLM_FALLBACK_MODEL=your-fallback-model

# Job sources (later slices)
FIRECRAWL_API_KEY=replace-me
ADZUNA_APP_ID=replace-me
ADZUNA_APP_KEY=replace-me

# App session and notifications (later slices)
SESSION_SECRET=replace-me
ALLOW_SIGNUP=false
NTFY_TOPIC=replace-me
