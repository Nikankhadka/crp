# Copy to .env and fill in. Never commit the real .env.

# LLM provider (OpenAI-compatible). Defaults to the free OpenCode Zen gateway.
# OPENCODE_API_KEY is accepted as an alias for LLM_API_KEY.
LLM_API_KEY=replace-me
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=nemotron-3.5-lightning-free
# Optional request timeout in milliseconds (default 90000)
LLM_TIMEOUT_MS=90000

# Optional free fallback, used once when the primary returns 429, 5xx or times out.
# Set LLM_FALLBACK_MODEL or LLM_FALLBACK_BASE_URL to activate it. The fallback key
# reuses LLM_API_KEY unless LLM_FALLBACK_API_KEY is set.
LLM_FALLBACK_BASE_URL=https://opencode.ai/zen/v1
LLM_FALLBACK_MODEL=nemotron-3-ultra-free

# Job sources (later slices)
FIRECRAWL_API_KEY=replace-me
ADZUNA_APP_ID=replace-me
ADZUNA_APP_KEY=replace-me

# App session and notifications (later slices)
SESSION_SECRET=replace-me
ALLOW_SIGNUP=false
NTFY_TOPIC=replace-me
